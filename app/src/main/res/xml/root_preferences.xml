<?xml version="1.0" encoding="utf-8"?>
<!-- Everything on the Settings screen. Values are saved automatically to SharedPreferences. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_header_general">

        <EditTextPreference
            app:defaultValue="@string/pref_default_display_name"
            app:key="user_display_name"
            app:title="@string/pref_title_display_name"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="@string/pref_default_email_address"
            app:key="user_email_address"
            app:title="@string/pref_title_email_address"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="@string/pref_default_favorite_social"
            app:entries="@array/pref_entries_favorite_social"
            app:entryValues="@array/pref_values_favorite_social"
            app:key="user_favorite_social"
            app:title="@string/pref_title_favorite_social"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_header_notifications">

        <!-- Since Android 8, sound/vibration are set per notification channel by the user,
             so we simply open the system screen for this app. -->
        <Preference
            app:key="notification_settings"
            app:summary="@string/pref_summary_notification_settings"
            app:title="@string/pref_title_notification_settings">
            <intent android:action="android.settings.APP_NOTIFICATION_SETTINGS">
                <extra
                    android:name="android.provider.extra.APP_PACKAGE"
                    android:value="com.ndhlangisa.pluralsight.notekeeper" />
            </intent>
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_header_data_sync">

        <ListPreference
            app:defaultValue="180"
            app:entries="@array/pref_sync_frequency_titles"
            app:entryValues="@array/pref_sync_frequency_values"
            app:key="sync_frequency"
            app:title="@string/pref_title_sync_frequency"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>